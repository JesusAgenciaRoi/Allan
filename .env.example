# Copia este archivo a .env.local y completa los valores.
# Sin VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY la app arranca en MODO DEMO (datos ficticios, sin persistencia real).

# URL del proyecto Supabase (Settings → API → Project URL)
VITE_SUPABASE_URL=
# Clave pública "anon"/"publishable" (segura en el frontend SOLO con RLS activado). NUNCA pongas aquí la service_role key.
VITE_SUPABASE_ANON_KEY=

# Bucket de Storage para los GIF/vídeos de ejercicios (lo crea la migración 0003)
VITE_EXERCISE_MEDIA_BUCKET=exercise-media
# Tamaño máximo de subida en MB (también se impone en el bucket de Storage)
VITE_MAX_UPLOAD_MB=15

# Enlace de WhatsApp de contacto (formato internacional, sin "+", ni espacios). Vacío = se oculta el botón.
VITE_WHATSAPP_NUMBER=
# Redes sociales (URLs completas). Vacío = se ocultan.
VITE_INSTAGRAM_URL=
VITE_TIKTOK_URL=
VITE_YOUTUBE_URL=

# Fuerza el modo demo aunque existan credenciales (true/false). Útil para presentaciones.
VITE_FORCE_DEMO=false
