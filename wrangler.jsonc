// Despliegue como Cloudflare Worker con assets estáticos (proyecto "allan").
// `npx wrangler deploy` ejecuta el build y sube dist/. El fallback SPA lo hace
// not_found_handling (por eso NO hay public/_redirects: provocaba un bucle infinito).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allan",
  "compatibility_date": "2026-10-06",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
